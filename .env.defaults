# {§splurnk-configuration} {§splurnk-deployment-boundary} {§splurnk-http-lifecycle}
# @plurnk/splurnk — application configuration floor.
# Active declarations are defaults; commented declarations are optional secrets.
# Put non-secret deployment overrides in .env and secrets in .env.keys (0600).
# Read exclusively through Knob (@plurnk/plurnk-meta) with no local fallback.

# --- HTTP listener and public identity ---
# Local bind address and TCP port behind the reverse proxy (or dialed directly in local dev).
SPLURNK_HOST=127.0.0.1
SPLURNK_PORT=3400
# Externally reachable origin (e.g., https://dev.splurnk.app, https://splurnk.app, or a self-hosted domain).
SPLURNK_PUBLIC_ORIGIN=http://127.0.0.1:3400
# End-to-end shutdown drain deadline, positive ms.
SPLURNK_STOP_TIMEOUT_MS=10000

# --- Persistence and Plurnk daemon seam ---
# SQLite database path managed by @possumtech/sqlrite.
SPLURNK_DB_PATH=data/splurnk.db
# Dedicated Plurnk daemon base URL (separate from an operator's personal :1066 daemon).
SPLURNK_PLURNK_URL=http://127.0.0.1:1067

# --- Chat and OIDC provider defaults ---
# Bot handle (without leading @) recognized for explicit group-chat mentions.
SPLURNK_BOT_HANDLE=splurnkbot
# Standard Telegram OIDC discovery issuer.
SPLURNK_TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
# Telegram Bot HTTP API origin.
SPLURNK_TELEGRAM_API_ORIGIN=https://api.telegram.org
# OIDC sign-in transaction lifetime in positive seconds.
SPLURNK_LOGIN_TTL_SEC=600
# Authenticated session lifetime in positive seconds (default 30 days).
SPLURNK_SESSION_TTL_SEC=2592000

# --- Secrets (supply via gitignored .env.keys [0600] or service environment, never here) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OIDC_CLIENT_ID=
# TELEGRAM_OIDC_CLIENT_SECRET=
# SPLURNK_SESSION_SECRET=
# PLURNK_SECRET=
