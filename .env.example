# Non-secret deployment overrides go in .env (gitignored):
# SPLURNK_PUBLIC_ORIGIN=https://dev.splurnk.app
# SPLURNK_PORT=3400
# SPLURNK_DB_PATH=/var/lib/splurnk/splurnk.db
# SPLURNK_PLURNK_URL=http://127.0.0.1:1067
# SPLURNK_BOT_HANDLE=splurnkbot

# Secrets live exclusively in .env.keys (gitignored, chmod 0600):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OIDC_CLIENT_ID=
# TELEGRAM_OIDC_CLIENT_SECRET=
# SPLURNK_SESSION_SECRET=
# PLURNK_SECRET=
