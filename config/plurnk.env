# {§splurnk-daemon-posture}
# Committed non-secret plurnk-service profile for Splurnk's dedicated Plurnk daemon.
# Launch isolated from personal ~/.local/share/plurnk state via PLURNK_SERVICE_STATE_ROOT
# and layer secrets from gitignored .env.keys (0600):
#   plurnk-service --config=config/plurnk.env --env-file-if-exists=.env.keys

# Dedicated local listener distinct from an operator's personal :1066 daemon.
PLURNK_HOST=127.0.0.1
PLURNK_PORT=1067
PLURNK_AUTH=1

# Disable all host subprocess executors (sh, js, python3, etc.) across rooms and sessions.
PLURNK_EXECS_ONLY=

# Deny ambient git inspection, untracked file admission, and model-initiated file creation.
PLURNK_SERVICE_GIT_ALLOWED=0
PLURNK_SERVICE_GIT_AUTO=0
PLURNK_SERVICE_FILE_CREATE_SCOPE=none
PLURNK_SERVICE_MEMBERS_MODEL_SCOPE=none
PLURNK_MEMBERS_AUTO_ADD=0

# Route any host/workspace mutation proposals through the session owner for role enforcement.
PLURNK_SERVICE_PROPOSALS=review

# Enable @plurnk/plurnk-schedule as the exclusive recurrence and wakeup subsystem.
PLURNK_SCHEDULE_ENABLED=1
